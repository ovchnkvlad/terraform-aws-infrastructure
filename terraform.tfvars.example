# Copy to terraform.tfvars for local experimentation. Never commit real identifiers.
project_name       = "platform-lab"
environment        = "dev"
aws_region         = "eu-central-1"
vpc_cidr           = "10.40.0.0/16"
enable_nat_gateway = false
enable_flow_logs   = true

tags = {
  Purpose = "learning"
}
